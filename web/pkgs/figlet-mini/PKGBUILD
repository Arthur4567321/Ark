# ArkForge recipe — figlet-mini
# USE flags: upper → uppercase banners; (default) → lowercase banners
pkgname=figlet-mini
pkgver=3
flags=(upper)
provides=(bin/figlet)

build() {
    if has_flag upper; then
        printf '#!/bin/sh\nfor w in "$@"; do printf "== %%s ==\\n" "$(printf %%s "$w" | tr a-z A-Z)"; done\n' > figlet
    else
        printf '#!/bin/sh\nfor w in "$@"; do printf "** %%s **\\n" "$w"; done\n' > figlet
    fi
}

package() {
    install -Dm755 figlet "$pkgdir/bin/figlet"
}

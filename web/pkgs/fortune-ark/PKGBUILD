# ArkForge recipe — fortune-ark
# USE flags: scifi → adds science-fiction quotes to the pool (baked in at build time)
pkgname=fortune-ark
pkgver=3
flags=(scifi)
provides=(bin/fortune)

build() {
    cat > fortune <<'EOF'
#!/bin/sh
set -- \
    "Talk is cheap. Show me the code." \
    "UNIX is simple. It just takes a genius to understand its simplicity." \
    "Programs must be written for people to read."
EOF
    if has_flag scifi; then
        cat >> fortune <<'EOF'
set -- "$@" \
    "There is no cloud, just other people's computers." \
    "The future is already here -- it's just not evenly distributed."
EOF
    fi
    cat >> fortune <<'EOF'
n=$((RANDOM % $# + 1))
i=1
for q in "$@"; do
    if [ "$i" -eq "$n" ]; then echo "$q"; exit 0; fi
    i=$((i + 1))
done
EOF
}

package() {
    install -Dm755 fortune "$pkgdir/bin/fortune"
}

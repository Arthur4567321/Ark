# ArkForge recipe — weather-cli
# USE flags: fahrenheit → imperial units; (default) → metric
pkgname=weather-cli
pkgver=3
flags=(fahrenheit)
provides=(bin/weather)

build() {
    if has_flag fahrenheit; then
        printf '#!/bin/sh\ncurl -s "wttr.in/${1:-Berlin}?format=3&u"\n' > weather
    else
        printf '#!/bin/sh\ncurl -s "wttr.in/${1:-Berlin}?format=3&m"\n' > weather
    fi
}

package() {
    install -Dm755 weather "$pkgdir/bin/weather"
}

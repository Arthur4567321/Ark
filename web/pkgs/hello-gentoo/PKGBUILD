# ArkForge recipe — hello-gentoo
# USE flags baked in at BUILD time (the forge way):
#   +color  → green output
#   +fancy  → "(fancy!)" suffix
#   +quotes → appends a classic quote
pkgname=hello-gentoo
pkgver=3
flags=(color fancy quotes)
provides=(bin/hello-gentoo)

build() {
    {
        echo '#!/bin/sh'
        if has_flag color; then
            echo 'printf "\033[32mhello-gentoo\033[0m"'
        else
            echo 'printf "hello-gentoo"'
        fi
        if has_flag fancy; then
            echo 'printf " (fancy!)"'
        fi
        echo 'echo'
        if has_flag quotes; then
            echo 'echo "\"Talk is cheap. Show me the code.\""'
        fi
        true    # keep the group's status 0 even when every flag is off
    } > hello-gentoo
}

package() {
    install -Dm755 hello-gentoo "$pkgdir/bin/hello-gentoo"
}

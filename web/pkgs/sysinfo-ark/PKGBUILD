# ArkForge recipe — sysinfo-ark
# USE flags: verbose → adds disk usage to the summary
pkgname=sysinfo-ark
pkgver=2
flags=(verbose)
provides=(bin/sysinfo)

build() {
    {
        echo '#!/bin/sh'
        echo 'echo "Kernel:  $(uname -r)"'
        echo 'echo "Uptime:  $(uptime -p)"'
        echo 'echo "Memory:  $(free -h | awk "/Mem:/ {print \$3 \" / \" \$2}")"'
        if has_flag verbose; then
            echo 'echo "Disk:    $(df -h / | awk "NR==2 {print \$3 \" / \" \$2 \" (\" \$5 \" used)\"}")"'
        fi
        true    # keep the group's status 0 even when the flag is off
    } > sysinfo
}

package() {
    install -Dm755 sysinfo "$pkgdir/bin/sysinfo"
}
